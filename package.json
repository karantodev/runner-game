{
  "name": "orchid-quest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "build": "node build.js",
    "build:standalone": "node scripts/build-standalone.mjs",
    "preview": "node build.js && node server.mjs",
    "check": "node build.js --check",
    "test:smoke": "playwright test tests/smoke.spec.js",
    "test:runtime": "playwright test tests/ecs-runtime.spec.js",
    "test": "playwright test",
    "audit:assets": "node scripts/audit-assets.mjs --check --strict",
    "audit:images": "node scripts/audit-images.mjs --check",
    "audit:composition": "node scripts/validate-composition.mjs --check",
    "audit:semantic": "node scripts/generate-semantic-registry.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "esbuild": "^0.28.0"
  },
  "dependencies": {
    "three": "^0.184.0"
  }
}
