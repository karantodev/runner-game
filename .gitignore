node_modules/
test-results/
playwright-report/
dist/
tmp/
.DS_Store

# Python bytecode cache from scripts/ tooling (e.g. asset re-export helpers).
__pycache__/
*.pyc

# Designer working files + asset backups — the engine never reads assets/_source/.
# Keeps the ~300 MB of oversized originals (backed up by scripts/optimize-assets.mjs)
# local-only so they don't bloat the repo. 54 legacy _source files are already
# tracked from earlier; run `git rm -r --cached assets/_source` to slim those too.
assets/_source/

# Artist hand-off scratch — candidate ZIPs, contact sheets, reference + current
# screenshots assembled for the human pixel-artist (M17/M18… redraw packages).
# ~97 MB of binaries the engine never reads; kept local-only so they never bloat
# the repo. Regenerate from the hand-off capture specs on demand.
docs/art-handoff/

# Generated docs — written by scripts/{audit-assets,audit-images,generate-asset-
# contact-sheets,generate-semantic-registry,validate-composition,capture-composition-
# pass}.mjs. No script READS them; they regenerate on demand. Kept out of git so the
# committed docs are only the hand-authored living set (brief, dev-guide, road-kit,
# style-audit, CHANGELOG, visual-qa). Re-run the matching script to refresh locally.
docs/asset-audit-report.md
docs/asset-semantic-action-list.md
docs/asset-missing-art-list.md
docs/asset-semantic-registry.md
docs/asset-production-manifest.md
docs/asset-cleanup-proposal.md
docs/asset-duplicate-cleanup-proposal.md
docs/asset-unregistered-decision-list.md
docs/asset-dead-key-decisions.md
docs/image-audit-report.md
docs/composition-validation-report.md
docs/visual-qa/asset-contact-sheets/README.md
docs/visual-qa/asset-contact-sheets/asset-visual-inventory.md
docs/visual-qa/composition-current/analysis.md

# Debug captures + visual-review artifacts — generated by throwaway capture
# specs / ffmpeg montage (phase-1 / step-2 before-after reviews, etc.).
# Regenerate on demand; kept local-only so they never bloat the repo. NOTE:
# `/*.png` ignores ALL repo-root capture/comparison PNGs (oq*, clean*, compare,
# etc.) — real art always lives in subdirs (assets/, blocks/, …), never the
# root. The zip pattern is scoped to review artifacts on purpose — a blanket
# *.zip would shadow the tracked deliveries/*.zip. (`tmp/` is ignored above.)
/artifacts/
/debug-captures/
/screenshots/
/*.png
*_visual_review_*.zip
